<?xml version="1.0" encoding="utf-8"?>
<VisualTemplate Guid="{AF5B7A6E-C182-4D9E-BFA0-B1C2D3E4F5A6}" Name="FxMeterC" Thumbnail="fx_meter">
  <Parameters>
    <Parameter Name="Equipment" Label="Equipment" Type="String" NamingRules="Equipment" />
